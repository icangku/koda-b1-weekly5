@model IEnumerable<Ewallet.Dtos.TransactionHistoryDto>
@{ ViewData["Title"] = "Transaction History"; }

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Transaction History</h5>
                <a href="/Wallets/Dashboard/@ViewBag.UserId" class="btn btn-sm btn-light">Back to Dashboard</a>
            </div>
            <div class="card-body">
                <div class="mb-3 d-flex gap-2">
                    <a href="/Transactions/Index/@ViewBag.UserId" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentFilter == null ? "active" : "")">All</a>
                    <a href="/Transactions/Index/@ViewBag.UserId?filter=Income" class="btn btn-outline-success btn-sm @(ViewBag.CurrentFilter == "Income" ? "active" : "")">Income</a>
                    <a href="/Transactions/Index/@ViewBag.UserId?filter=Expense" class="btn btn-outline-danger btn-sm @(ViewBag.CurrentFilter == "Expense" ? "active" : "")">Expense</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Sender</th>
                                <th>Receiver</th>
                                <th>Amount</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">No transaction yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge @(item.Type == "TopUp" ? "bg-success" : "bg-primary")">@item.Type</span>
                                        </td>
                                        <td>@item.SenderWalletNumber</td>
                                        <td>@item.ReceiverWalletNumber</td>
                                        <td class="fw-bold">Rp @item.Amount.ToString("N0")</td>
                                        <td>@item.Description</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>