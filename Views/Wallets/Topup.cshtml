@{ ViewData["Title"] = "Top Up"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Form Top Up Saldo</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <p>Nomor Wallet: <strong>@ViewBag.WalletNumber</strong></p>

                <form method="post" action="/Wallets/TopUp/@ViewBag.UserId">
                    <div class="mb-3">
                        <label class="form-label">Nominal Top Up (Rp)</label>
                        <input type="number" step="0.01" min="1" name="amount" class="form-control" required />
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="/Wallets/Dashboard/@ViewBag.UserId" class="btn btn-secondary">Kembali</a>
                        <button type="submit" class="btn btn-success">Submit Top Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>